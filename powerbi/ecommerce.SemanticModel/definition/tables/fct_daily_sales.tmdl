table fct_daily_sales
	lineageTag: a6e22003-f2bd-4fc0-8f2e-3a0c3f95b92a

	measure 'Total Revenue' = SUM(fct_daily_sales[revenue])
		formatString: \$#,0
		lineageTag: 6249dd82-f58c-4c54-97cd-525f7d62b803

	measure 'Total Orders' = SUM(fct_daily_sales[orders])
		formatString: #,0
		lineageTag: 1acc37dd-9123-4d8f-9220-26c029ae78e4

	measure AOV = DIVIDE([Total Revenue], [Total Orders])
		formatString: \$#,0.00
		lineageTag: c51d5987-2545-42cf-8215-831f89b92978

	/// Rata-rata pembeli unik per hari. Gold hanya menyimpan pembeli unik per hari, jadi angka ini sengaja tidak dijumlah lintas hari.
	measure 'Avg Daily Buyers' = AVERAGE(fct_daily_sales[buyers])
		formatString: #,0
		lineageTag: dc6c49b5-bbad-4aa1-86b9-5262f62e8f72

	column event_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 34e6748f-9d14-453c-95a4-b9436dcd7915
		summarizeBy: none
		sourceColumn: event_date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column revenue
		dataType: double
		lineageTag: bae5ec33-ea9f-40b0-bb5a-f27709491715
		summarizeBy: sum
		sourceColumn: revenue

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column purchase_events
		dataType: int64
		formatString: 0
		lineageTag: d51f3259-57aa-488f-8753-e1701fa21c4a
		summarizeBy: sum
		sourceColumn: purchase_events

		annotation SummarizationSetBy = Automatic

	column orders
		dataType: int64
		formatString: 0
		lineageTag: c051e0f9-b501-43c9-9ae8-bd53093db9b1
		summarizeBy: sum
		sourceColumn: orders

		annotation SummarizationSetBy = Automatic

	column buyers
		dataType: int64
		formatString: 0
		lineageTag: 69531d7f-3306-484d-b94d-85ecd417bd44
		summarizeBy: sum
		sourceColumn: buyers

		annotation SummarizationSetBy = Automatic

