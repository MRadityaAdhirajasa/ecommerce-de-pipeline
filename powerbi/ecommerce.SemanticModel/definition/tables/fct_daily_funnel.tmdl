		formatString: 0
		lineageTag: c882678d-5e29-4741-ae62-c4fd45782a71
		summarizeBy: sum
		sourceColumn: sessions_view

		annotation SummarizationSetBy = Automatic

	column sessions_cart
		dataType: int64
		formatString: 0
		lineageTag: e53c67d1-5f39-4074-b23f-50910e826116
		summarizeBy: sum
		sourceColumn: sessions_cart

		annotation SummarizationSetBy = Automatic

	column sessions_purchase
		dataType: int64
		formatString: 0
		lineageTag: 77192a38-61ce-4419-9000-25f44a6a7543
		summarizeBy: sum
		sourceColumn: sessions_purchase

		annotation SummarizationSetBy = Automatic

	column sessions_purchase_no_cart
		dataType: int64
		formatString: 0
		lineageTag: d2525afd-7ba0-4e37-92f5-f253e6268b39
		summarizeBy: sum
		sourceColumn: sessions_purchase_no_cart

		annotation SummarizationSetBy = Automatic

	column conversion_rate
