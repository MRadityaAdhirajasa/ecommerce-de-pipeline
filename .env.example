# Salin file ini jadi .env lalu isi nilai aslinya. .env tidak pernah di-commit.
# Ambil HOST dari URL workspace, HTTP_PATH dari SQL Warehouses > Connection details,
# TOKEN dari Settings > Developer > Access tokens, JOB_ID dari URL halaman Job.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
DATABRICKS_CATALOG=ecommerce
DATABRICKS_VOLUME_PATH=/Volumes/ecommerce/raw/landing/events
DATABRICKS_JOB_ID=000000000000000

# Dipakai dbt saat dijalankan dari laptop. Di dalam container Airflow,
# nilai ini ditimpa jadi /opt/airflow/dbt lewat docker-compose.yaml.
DBT_PROFILES_DIR=./dbt
